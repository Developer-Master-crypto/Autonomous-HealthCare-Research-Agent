# ==============================================================================
# ResearchOps - Environment Variables Configuration Template
# TEAM: Spideyx | HACKATHON: GATEWAYS 2026
#
# IMPORTANT: Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the active '.env' file or any secrets to version control.
# ==============================================================================

# Application Environment & Server Settings
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=true
PROJECT_NAME="ResearchOps API"
VERSION="0.1.0"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# Database & Vector Store (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:password@localhost:5432/researchops

# ------------------------------------------------------------------------------
# Provider-Agnostic LLM Integrations
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=gemini
# Optional provider keys - configure the provider(s) you intend to use
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
GROQ_API_KEY=your_groq_api_key_placeholder

# LLM Model Selection defaults
DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# External Research & Search Connectors (For Future Phases)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_placeholder
SERPAPI_API_KEY=your_serpapi_api_key_placeholder
