# Local-only configuration template. Copy to .env and replace only values you use.
# Never commit .env or place backend credentials in frontend files.
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ResearchOps API"
VERSION="0.1.0"

# CORS origins for the served UI or a separate local frontend dev server.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Optional live persistence. Without these settings the app uses process-local,
# in-memory storage for local development; data will not survive a restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# Optional live web search. Without this key, research runs are labelled
# unconfigured and no external results are fabricated.
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=10
SOURCE_FETCH_TIMEOUT_SECONDS=15
MAX_SOURCE_CONTENT_CHARS=12000
RESEARCH_RATE_LIMIT_PER_MINUTE=20

# Local mock lookup only. For production set GEOCODING_PROVIDER=nominatim.
GEOCODING_PROVIDER=mock
