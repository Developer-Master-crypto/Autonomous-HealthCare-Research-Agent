diff --git a/backend/tests/test_geographic.py b/backend/tests/test_geographic.py
index ad702a5..fa27f6a 100644
--- a/backend/tests/test_geographic.py
+++ b/backend/tests/test_geographic.py
@@ -92,6 +92,23 @@ class TestMockGeocodingProvider:
         assert abs(result.coordinates.latitude - 12.3456) < 0.001
         assert abs(result.coordinates.longitude - (-78.9012)) < 0.001
 
+    def test_demo_location_whitefield_resolves_by_default(self):
+        # The README demo query targets Whitefield; it must work without custom seeding.
+        result = MockGeocodingProvider().geocode("Whitefield")
+        assert result.success is True
+        assert abs(result.coordinates.latitude - 12.9698) < 0.01
+        assert abs(result.coordinates.longitude - 77.75) < 0.01
+
+    def test_city_only_query_matches_seeded_city(self):
+        assert MockGeocodingProvider().geocode("Columbus").success is True
+
+    def test_fragments_and_regions_do_not_fabricate_coordinates(self):
+        provider = MockGeocodingProvider()
+        for query in ("a", "o", "Ohio", "Texas", "York"):
+            result = provider.geocode(query)
+            assert result.success is False, query
+            assert result.coordinates is None, query
+
     def test_case_insensitive_lookup(self):
         provider = MockGeocodingProvider()
         r1 = provider.geocode("COLUMBUS, OHIO")
